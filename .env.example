# PostgreSQL
DATABASE_URL=postgresql://user:pass@db:5432/syn

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# Коллекции по назначению (остаток Фазы 2):
QDRANT_NORMS_COLLECTION=norm_documents
QDRANT_CATALOG_COLLECTION=mtr_descriptions
QDRANT_DOCUMENTS_COLLECTION=documents
# QDRANT_COLLECTION=mtr_descriptions  # legacy-псевдоним (не используется)

# Redis (кеш + брокер Celery)
REDIS_URL=redis://redis:6379/0

# JWT
SECRET_KEY=change-this-to-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# LLM
LLM_MODEL=llama3:70b
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=120
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/
OPENROUTER_TOKEN=

# OCR
OCR_ENGINE=tesseract
# Каталог сохранения загруженных паспортов (пусто — <repo>/data/uploads)
# DOCUMENT_UPLOAD_DIR=

# CORS
CORS_ORIGINS=http://localhost:3000

# Embeddings
EMBEDDING_MODEL=BAAI/bge-m3
HF_TOKEN=

# App
LOG_LEVEL=INFO
AGENT_LLM_MODE=on
AGENT_STORAGE=db
